# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real credentials.
#
# Both values come from the X developer portal:
#   your app -> Keys and tokens -> OAuth 2.0 Client ID and Client Secret

X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional. Must match the callback URI configured in the portal EXACTLY,
# trailing slashes included.
# X_REDIRECT_URI=http://localhost:3000/callback

# Optional. Space-separated. offline.access is what gets you a refresh token.
# Add follows.write if you need the account to follow or unfollow others.
# X_SCOPES=tweet.read tweet.write users.read offline.access
